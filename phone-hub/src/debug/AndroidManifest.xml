<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".PhoneProbeBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.anezium.rokidbus.phone.PROBE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".DebugFakeGlassesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.anezium.rokidbus.phone.DEBUG_GLASSES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
