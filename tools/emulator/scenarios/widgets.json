            "row": 1
          },
          {
            "pluginId": "transit",
            "size": "1x1",
            "col": 2,
            "row": 1
          },
          {
            "pluginId": "relay",
            "size": "1x1",
            "col": 3,
            "row": 1
          },
          {
            "pluginId": "agents",
            "size": "2x1",
            "col": 0,
            "row": 2
          },
          {
            "pluginId": "lens",
            "size": "1x1",
